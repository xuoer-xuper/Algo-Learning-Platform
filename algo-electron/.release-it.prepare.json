{
  "npm": { "publish": false, "allowSameVersion": true, "versionArgs": ["--ignore-scripts"] },
  "git": {
    "requireBranch": ["!master", "!dev"],
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "commit": false,
    "tag": false,
    "push": false,
    "tagName": "v${version}",
    "changelog": false
  },
  "github": { "release": false },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "../docs/PRODUCT/CHANGELOG.md",
      "header": "# 更新日志\n\n本文件记录面向用户和维护者的可见变化。",
      "preset": "conventionalcommits",
      "ignoreRecommendedBump": true,
      "context": { "previousTag": "v2.0.0" },
      "gitRawCommitsOpts": { "from": "v2.0.0" }
    }
  },
  "hooks": { "before:init": "node scripts/release-cli.mjs guard-prepare" }
}

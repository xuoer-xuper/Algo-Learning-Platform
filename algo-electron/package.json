{
  "name": "algo-electron",
  "private": true,
  "version": "2.0.0-beta.2",
  "description": "Local-first algorithm learning tracker desktop app",
  "author": "Algo Learning Platform Contributors",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && electron-builder",
    "build:win": "tsc && vite build && electron-builder --win nsis",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node tests/run-tests.mjs core",
    "test:core": "node tests/run-tests.mjs core",
    "test:ai": "node tests/run-tests.mjs ai",
    "test:architecture": "node tests/run-tests.mjs architecture",
    "test:security": "node tests/run-tests.mjs security",
    "test:adapters": "node tests/run-tests.mjs adapters",
    "test:submissions": "node tests/run-tests.mjs submissions",
    "test:db": "node tests/run-tests.mjs db",
    "test:docs": "node tests/run-tests.mjs docs",
    "test:packaging": "node tests/run-tests.mjs packaging",
    "test:electron": "node tests/run-tests.mjs electron",
    "test:ui": "node tests/run-tests.mjs ui",
    "test:coach": "node tests/run-tests.mjs coach",
    "test:all": "node tests/run-tests.mjs all"
  },
  "dependencies": {
    "@milkdown/crepe": "7.22.0",
    "@milkdown/theme-nord": "7.22.0",
    "better-sqlite3": "^12.10.0",
    "openai": "^6.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "^42.2.0",
    "electron-builder": "^24.13.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-electron": "1.1.1",
    "vite-plugin-electron-renderer": "1.0.0"
  },
  "main": "dist-electron/main.js"
}

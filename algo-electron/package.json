{
  "name": "algo-electron",
  "private": true,
  "version": "2.0.0-beta.2",
  "description": "Local-first algorithm learning tracker desktop app",
  "author": "Algo Learning Platform Contributors",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "postinstall": "npm run install:electron && npm run install:app-deps",
    "install:electron": "install-electron --no",
    "install:app-deps": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "build:check": "tsc && vite build && npm run test:packaged-main",
    "build": "tsc && vite build && npm run test:packaged-main && electron-builder",
    "build:win": "tsc && vite build && npm run test:packaged-main && electron-builder --win nsis && npm run test:packaged-app",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:core": "node tests/verify.mjs core",
    "test:ai": "node tests/verify.mjs ai",
    "test:architecture": "node tests/architecture/check-architecture.mjs",
    "test:security": "node tests/security/check-sensitive-files.mjs",
    "test:adapters": "vitest run tests/adapters",
    "test:submissions": "vitest run tests/submissions",
    "test:db": "node tests/verify.mjs db",
    "test:docs": "node tests/docs/check-docs.mjs",
    "test:packaging": "node tests/packaging/check-packaging.mjs",
    "test:packaged-main": "node tests/packaging/checkPackagedMain.mjs",
    "test:packaged-app": "node tests/packaging/checkPackagedApp.mjs",
    "test:performance": "node tests/performance/checkRendererBundle.mjs",
    "test:electron": "node tests/verify.mjs electron",
    "test:ui": "node tests/ui/runPlaywright.mjs",
    "test:coach": "node tests/verify.mjs coach",
    "test:all": "node tests/verify.mjs all"
  },
  "dependencies": {
    "@milkdown/crepe": "7.22.0",
    "better-sqlite3": "13.0.3",
    "openai": "7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.10.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-electron": "1.1.1",
    "vite-plugin-electron-renderer": "1.0.0",
    "vitest": "4.1.10"
  },
  "main": "dist-electron/main.js"
}
